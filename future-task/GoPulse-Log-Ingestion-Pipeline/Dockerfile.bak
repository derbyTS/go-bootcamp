# Stage 1: Build static binary
FROM golang:1.22-alpine AS builder
WORKDIR /app

# Dependency caching
COPY go.mod go.sum ./
RUN go download

COPY . .

# Disable CGO for a pure, statically-linked binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o gopulse ./cmd/gopulse

# Stage 2: Minimal Distroless/Scratch Runtime Container (~10-15MB total)
FROM scratch
WORKDIR /
COPY --from=builder /app/gopulse /gopulse
EXPOSE 8080 50051
ENTRYPOINT ["/gopulse"]
